# Delivery Service Chatbot — Environment template
# Copy to .env and fill in values:  cp .env.example .env

# --- Application ---
APP_ENV=local
APP_NAME=delivery-bot
LOG_LEVEL=INFO
LOG_JSON=true

# --- Telegram ---
TELEGRAM_BOT_TOKEN=replace_me_with_botfather_token
# Для Telegram на телефоне нужен HTTPS (ngrok/cloudflare tunnel), например https://xxxx.ngrok.io/ui
TELEGRAM_WEBAPP_URL=http://localhost:8000/ui

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=delivery
POSTGRES_USER=delivery
POSTGRES_PASSWORD=delivery_secret
DATABASE_URL=postgresql+asyncpg://delivery:delivery_secret@postgres:5432/delivery

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Internal API / Admin ---
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=dev_api_key_change_me
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=admin_change_me

# --- Health (bot sidecar) ---
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8081

# --- Dialog / sessions ---
SESSION_TTL_SECONDS=1800
CONSENT_TTL_SECONDS=31536000
VERIFY_MAX_ATTEMPTS=5
VERIFY_ATTEMPT_WINDOW_SECONDS=900
VERIFY_BLOCK_SECONDS=1800

# --- OMS ---
OMS_BASE_URL=http://api:8000
OMS_TIMEOUT_SECONDS=3
STATUS_CACHE_TTL_SECONDS=90

# --- WebApp ---
WEBAPP_DEV_BYPASS=true
WEBAPP_BINDING_TTL_SECONDS=86400
WEBAPP_INIT_DATA_MAX_AGE_SECONDS=86400

# --- Feature flags ---
LLM_FAQ_ENABLED=false
PAYMENT_MOCK=true
OMS_MOCK=true

# --- External (stubs / later) ---
YANDEX_MAPS_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
