# Delivery Service Chatbot — Environment template
# Copy to .env and fill in values:  cp .env.example .env
#
# PRODUCTION (APP_ENV=production): Settings отклонит запуск, если не сменить:
#   API_KEY, ADMIN_BASIC_PASSWORD (не дефолты), TELEGRAM_BOT_TOKEN (непустой),
#   WEBAPP_DEV_BYPASS=false. Также смените POSTGRES_PASSWORD / секреты в URL.

# --- Application ---
# local | test | production
APP_ENV=local
APP_NAME=delivery-bot
LOG_LEVEL=INFO
LOG_JSON=true

# --- Telegram ---
# REQUIRED in production: токен BotFather (не оставляйте пустым / replace_me)
TELEGRAM_BOT_TOKEN=replace_me_with_botfather_token
# Для Telegram на телефоне нужен HTTPS (ngrok/cloudflare tunnel), например https://xxxx.ngrok.io/ui
# На сервере: публичный HTTPS URL на HOST_API_PORT (по умолчанию 18000)
TELEGRAM_WEBAPP_URL=http://localhost:18000/ui

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=delivery
POSTGRES_USER=delivery
# REQUIRED to change in production
POSTGRES_PASSWORD=delivery_secret
DATABASE_URL=postgresql+asyncpg://delivery:delivery_secret@postgres:5432/delivery

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Host ports (публикуются наружу; внутри compose api всё ещё :8000) ---
# Меняйте, если на сервере заняты 18000 / 18081
HOST_API_PORT=18000
HOST_BOT_HEALTH_PORT=18081

# --- Internal API / Admin ---
API_HOST=0.0.0.0
API_PORT=8000
# REQUIRED to change in production (default rejected by Settings guard)
API_KEY=dev_api_key_change_me
ADMIN_BASIC_USER=admin
# REQUIRED to change in production (default rejected by Settings guard)
ADMIN_BASIC_PASSWORD=admin_change_me

# --- Health (bot sidecar, внутри контейнера) ---
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8081

# --- Dialog / sessions ---
SESSION_TTL_SECONDS=1800
CONSENT_TTL_SECONDS=31536000
VERIFY_MAX_ATTEMPTS=5
VERIFY_ATTEMPT_WINDOW_SECONDS=900
VERIFY_BLOCK_SECONDS=1800

# --- OMS ---
OMS_BASE_URL=http://api:8000
OMS_TIMEOUT_SECONDS=3
STATUS_CACHE_TTL_SECONDS=90

# --- WebApp ---
# MUST be false in production (Settings guard)
WEBAPP_DEV_BYPASS=true
WEBAPP_BINDING_TTL_SECONDS=86400
WEBAPP_INIT_DATA_MAX_AGE_SECONDS=86400

# --- Feature flags ---
LLM_FAQ_ENABLED=false
PAYMENT_MOCK=true
OMS_MOCK=true

# --- Post-delivery ---
CLAIM_WINDOW_DAYS=14
REVIEW_REMINDER_DELAY_SECONDS=3600

# --- Observability ---
METRICS_ENABLED=true

# --- External (stubs / later) ---
# Ключ JS API Яндекс.Карт (опционально; без ключа в UI — OpenStreetMap)
YANDEX_MAPS_API_KEY=
# OpenAI-compatible FAQ LLM (при LLM_FAQ_ENABLED=true без ключа — MockLlm)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MOCK_LATENCY_MS=80
